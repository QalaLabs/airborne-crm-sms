model Job {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @db.Uuid
  hiringPartnerId String?   @db.Uuid
  title           String    @db.VarChar(255)
  slug            String    @db.VarChar(255)
  description     String?   @db.Text
  requirements    String?   @db.Text
  location        String?   @db.VarChar(255)
  isRemote        Boolean   @default(false)
  jobType         String    @default("full_time") @db.VarChar(50) // full_time, part_time, contract, internship
  salaryMin       Decimal?  @db.Decimal(12, 2)
  salaryMax       Decimal?  @db.Decimal(12, 2)
  currency        String    @default("INR") @db.VarChar(3)
  experienceYears Int?
  status          JobStatus @default(DRAFT)
  publishedAt     DateTime?
  closesAt        DateTime?
  tags            String[]
  courseIds       String[] // courses whose graduates are eligible
  seoTitle        String?   @db.VarChar(255)
  seoDesc         String?   @db.Text
  metadata        Json      @default("{}")
  publishedBy     String?   @db.Uuid
  createdBy       String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org           Organization     @relation("OrgJobs", fields: [orgId], references: [id], onDelete: Cascade)
  hiringPartner HiringPartner?   @relation(fields: [hiringPartnerId], references: [id], onDelete: SetNull)
  creator       User?            @relation("JobCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  publisher     User?            @relation("JobPublisher", fields: [publishedBy], references: [id], onDelete: SetNull)
  applications  JobApplication[]

  @@unique([orgId, slug])
  @@index([orgId, status])
  @@index([orgId, hiringPartnerId])
  @@map("jobs")
}

model JobApplication {
  id             String               @id @default(uuid()) @db.Uuid
  orgId          String               @db.Uuid
