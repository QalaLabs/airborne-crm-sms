# ─── Airborne Admin OS - Environment Template ────────────────────────────────
# Copy to .env.local for local dev. Set all REQUIRED vars in Vercel before deploy.
# Never commit real secrets.
#
# ⚠️ ENVIRONMENT BOUNDARY: these secrets live ONLY on the admin project.
# Never add them to the marketing site's env (Vercel project
# `airborne-web`/`airbone`): DATABASE_URL, DIRECT_URL, AUTH_SECRET,
# SUPABASE_SERVICE_ROLE_KEY, INNGEST_*. The marketing app reaches this API only
# via ADMIN_API_URL + PUBLIC_INTAKE_KEY over HTTP.

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
# Neon / Supabase PostgreSQL - use a connection-pooler URL for DATABASE_URL
DATABASE_URL="postgresql://user:password@pooler-host:5432/airborne_admin?sslmode=require&pgbouncer=true"
# Direct (non-pooled) URL for Prisma migrate deploy - bypasses PgBouncer
DIRECT_URL="postgresql://user:password@direct-host:5432/airborne_admin?sslmode=require"
#
# ⚠️ DB SAFETY INTERLOCK (Section 7 / H-04): every DB-mutating npm script
# (`build`, `db:migrate`, `db:migrate:prod`, `db:push`, `db:seed`, `db:reset`,
# `test:local`, and `prisma db seed`) first runs `scripts/safe-db-check.mjs`,
# which REFUSES to run unless `DATABASE_URL` is set explicitly in the shell
# environment AND the target is loopback + `airbone_test`. This exists because
# the committed `admin/.env` points at PRODUCTION Cloud SQL — a bare command
# would silently mutate prod. For local work, export:
#
#   $env:DATABASE_URL="postgresql://postgres:postgres@localhost:5433/airbone_test?schema=public"
#   $env:DIRECT_URL="postgresql://postgres:postgres@localhost:5433/airbone_test"
#   npm run test:local        # full gated suite against the disposable DB
#
# SAFE_DB_EXPECT_DB — expected local database name (default: airbone_test).
# SAFE_DB_ALLOW_PROD     — explicit escape hatch; only honoured together with
#                          NODE_ENV=production (real Cloud Run deploys).

# ─── Auth.js v5 (REQUIRED) ───────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Full URL of this admin app (no trailing slash)
AUTH_URL="https://admin.airborneacademy.in"

# ─── Public API (REQUIRED) ───────────────────────────────────────────────────
# Shared secret between marketing site and admin API - set the same value in both
PUBLIC_INTAKE_KEY="replace-with-a-random-secret-min-32-chars"
# Org slug used for public API queries (default: airborne-aviation)
PUBLIC_ORG_SLUG="airborne-aviation"

# ─── Supabase Storage (media uploads) ────────────────────────────────────────
# Canonical object storage for the media library. SUPABASE_SERVICE_ROLE_KEY is
# a server-only credential (never expose it to the browser). The bucket is
# auto-created (public) on first use if it does not exist.
# Missing SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY → media uploads/list/delete
# return 503 STORAGE_UNAVAILABLE; deletes degrade to DB-only soft delete.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="media"

# ─── Cloudflare R2 (LEGACY - documents only) ─────────────────────────────────
# R2 remains only for the documents feature. The media library no longer uses R2.
# Missing in dev → mock presign URL returned (no crash).
# Missing in production → document uploads throw a clear error.
R2_ACCOUNT_ID="your-cf-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="airborne-media"
R2_BUCKET_DOCS="airborne-docs"
R2_PUBLIC_URL="https://media.airborneacademy.in"

# ─── Inngest (LEGACY - no longer read by the app) ────────────────────────────
# The internal_events/automation engine fully replaced the Inngest client
# (emitEvent → dispatchEvent persists to DB and processes inline; cron polls).
# These variables are kept only so old CI/deploy scripts don't break. Safe to
# remove after deploy pipeline is updated; NOT read by application code.
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""

# ─── Trusted Proxy & Rate Limiting (Section 1 hardening) ──────────────────────
# TRUSTED_PROXY controls how client IPs are resolved for rate-limit keys:
#   none       (default) - no trusted proxy; first XFF value used as a coarse
#                          correlation token only (dev). NOT enforcement-grade.
#   cloud-run  - deployed behind Cloud Run's managed HTTPS ingress (GFE), which
#                APPENDS the real visitor IP as the rightmost X-Forwarded-For
#                element; only rightmost IP literals are trusted here.
TRUSTED_PROXY="none"
# RATE_LIMIT_STORE picks the rate-limit backend:
#   auto (default) - use Upstash when UPSTASH_REDIS_REST_URL/TOKEN are set,
#                    otherwise the per-instance in-memory store.
#   memory         - force per-instance in-memory (single instance / dev).
#   upstash        - force distributed (fails open to memory if misconfigured).
RATE_LIMIT_STORE="auto"

# ─── Upstash Redis (OPTIONAL - ACTIVE for distributed rate limiting) ──────────
# When RATE_LIMIT_STORE=auto|upstash AND these two are set, login/forgot/reset/
# invite/lead/resource limits are enforced across ALL Cloud Run instances.
# Get both from the Upstash console. Requests never touch the app's datastore.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Google Gemini AI (OPTIONAL) ─────────────────────────────────────────────
# Powers the LMS study assistant. Missing → stub response returned, no crash.
GEMINI_API_KEY=""

# ─── Twilio SMS (OPTIONAL - reserved for future SMS notifications) ────────────
# Not yet wired in code. Safe to leave blank; no runtime crash.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ─── WATI WhatsApp (OPTIONAL - reserved for future notifications) ─────────────
# Sprint 5 notification worker. Safe to leave blank; no runtime crash.
WATI_API_URL=""
WATI_API_TOKEN=""

# ─── Email (OPTIONAL) ─────────────────────────────────────────────────────────
# EMAIL_PROVIDER=resend (default) | smtp
EMAIL_PROVIDER="smtp"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@airborneaviation.in"
# Gmail / Google Workspace SMTP (EMAIL_PROVIDER=smtp)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="noreply@airborneaviation.in"
SMTP_PASS=""
SMTP_FROM="noreply@airborneaviation.in"
# Leave unset/false for port 587 STARTTLS; set true only for 465 SSL
SMTP_SECURE="false"

# ─── CRM Integrations (OPTIONAL) ─────────────────────────────────────────────
NEXT_PUBLIC_FACEBOOK_APP_ID=""
# NOTE: NEXT_PUBLIC_GOOGLE_ADS_CONFIGURED and NEXT_PUBLIC_FRAPPE_URL were pruned
# (L-03) — no code consumer exists.

# ─── Lead Recycle Bin ────────────────────────────────────────────────────────
# Days a deleted lead stays restorable before permanent deletion (1–365).
LEAD_TRASH_RETENTION_DAYS="30"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://admin.airborneacademy.in"
NEXT_PUBLIC_APP_NAME="Airborne OS"
NODE_ENV="production"

# ─── admin/scratch/ QA & ops scripts only (not read by the app) ─────────────
# These are read via admin/scratch/_env.ts. Never hardcode them in the scripts.
CLOUD_SQL_DATABASE_URL="postgresql://user:password@cloud-sql-ip/airbornedb"
SUPABASE_ANON_KEY="replace-with-supabase-anon-key"
# Only needed to run create-secrets.ps1 - production values that differ from
# the local dev AUTH_SECRET/OTP_HASH_SECRET above.
PROD_AUTH_SECRET="replace-with-openssl-rand-base64-32"
PROD_OTP_HASH_SECRET="replace-with-openssl-rand-base64-32"
